# Local development only; choose your own password. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

# Tutor defaults: local demonstration, no external model request.
PHYSICS_LLM_PROVIDER=mock
PHYSICS_LLM_MODEL=mock-v1
PHYSICS_LLM_ENABLE_REAL=0
# For an explicitly configured HTTPS Responses provider only:
# PHYSICS_LLM_PROVIDER=openai_responses
# PHYSICS_LLM_BASE_URL=https://api.openai.com/v1
# PHYSICS_LLM_MODEL=gpt-6.1-sol
# PHYSICS_LLM_REASONING_EFFORT=medium
# PHYSICS_LLM_ENABLE_REAL=1
# PHYSICS_LLM_API_KEY=<secure-environment-binding-not-a-repository-value>
